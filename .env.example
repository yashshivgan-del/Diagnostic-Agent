# Copy to .env and fill in. Never commit .env.

# ---- Database (backend login created by db/03_roles.sql)
# RDS: postgresql://pda_app:<password>@load-opt-demo.cr0wcueo0rpo.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
# (tables live in schema pda inside database postgres; the code always schema-qualifies pda.*)
DATABASE_URL=postgresql://pda_app:CHANGE_ME_app_password@localhost:5432/pda

# ---- Inference
# synthetic = local demo score (no AWS; NOT an ML prediction)
# sagemaker = RCF + XGBoost endpoints (see ml/ and docs/SETUP_GUIDE.md step 5)
INFERENCE_MODE=synthetic
AWS_REGION=us-east-1
RCF_ENDPOINT_NAME=pda-rcf
XGB_ENDPOINT_NAME=pda-xgb
# from ml/train_rcf.py output
ANOMALY_THRESHOLD_RCF=3.0
# contents of ml/artifacts/rcf_scaler.json (one line)
RCF_SCALER_JSON=
ANOMALY_THRESHOLD_SYNTHETIC=2.5

# ---- Simulation / workshop rules
SIM_INTERVAL_S=10
# auto-stop after 10 minutes
RUN_MAX_SECONDS=600
MAX_ACTIVE_RUNS=60
CONFIRM_WINDOW=3
CONFIRM_MIN=2
REARM_NORMAL_READINGS=3
MAX_TRIGGERS_PER_RUN=8
EMAIL_CAP_PER_RUN=5

# ---- Karini (one recipe for everyone)
KARINI_ENABLED=true
# These are the DEFAULT/fallback credentials. Each student can override them per run from the
# Start form (base URL + recipe ID + API token), so every student uses their own recipe. A run
# with its own creds ignores these; a run without them falls back to the values here (e.g. the
# local docker mock). Leave blank in the workshop if every student supplies their own.
# https://app.karini.ai (prod) or your environment's host; local docker compose uses the mock
KARINI_BASE_URL=https://app.karini.ai
# recipe id ONLY, e.g. 6acf524f0342557bb26f586b (the backend builds .../api/webhook/recipe/<id> itself)
KARINI_RECIPE_ID=
KARINI_API_TOKEN=
KARINI_MAX_CONCURRENT=10
KARINI_POLL_INTERVAL_S=15
KARINI_EXECUTION_TIMEOUT_S=600
